# Which provider to use: gemini (default) | anthropic | openai
LLM_PROVIDER=gemini
# Optional model override. Defaults: gemini-3.5-flash-lite | claude-haiku-5-5 | gpt-5-nano
# LLM_MODEL=
# Optional second provider tried when the primary fails twice
# LLM_FALLBACK_PROVIDER=anthropic

# Only the key for the provider(s) you use is required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Global daily request cap (protects the free tier / budget)
DAILY_REQUEST_CAP=2000
